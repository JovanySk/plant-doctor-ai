# Get a key at https://aistudio.google.com/apikey — never commit the real one.
GEMINI_API_KEY=your_google_ai_studio_key_here
# Any vision-capable Gemini model that supports generateContent.
GEMINI_MODEL=gemini-3.5-flash
# "low" keeps Gemini 3.x answers fast (~10 s). Leave empty for models without thinking support.
GEMINI_THINKING_LEVEL=low
PORT=3001
